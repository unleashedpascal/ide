<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="UnleashedComponents"/>
    <Type Value="RunAndDesignTime"/>
    <AddToProjectUsesSection Value="True"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)/$(LCLWidgetType)"/>
      </SearchPaths>
      <Other>
        <CustomOptions Value="$(IDEBuildOptions)"/>
      </Other>
    </CompilerOptions>
    <Description Value="Unleashed Components: controls and tools for LCL applications, with TAppTheme putting a color theme on the whole application.
"/>
    <License Value="Copyright (c) 2026 Unleashed Pascal Contributors &lt;https://unleashedpascal.org>

Mozilla Public License, v. 2.0 (SPDX-License-Identifier: MPL-2.0). The full text is available at https://mozilla.org/MPL/2.0/.
"/>
    <Version Major="1"/>
    <Files>
      <Item>
        <Filename Value="apptheme.pas"/>
        <UnitName Value="AppTheme"/>
      </Item>
      <Item>
        <Filename Value="rangeslider.pas"/>
        <UnitName Value="RangeSlider"/>
      </Item>
      <Item>
        <Filename Value="controlpaint.pas"/>
        <UnitName Value="ControlPaint"/>
      </Item>
      <Item>
        <Filename Value="toggleswitch.pas"/>
        <UnitName Value="ToggleSwitch"/>
      </Item>
      <Item>
        <Filename Value="searchedit.pas"/>
        <UnitName Value="SearchEdit"/>
      </Item>
      <Item>
        <Filename Value="splitbutton.pas"/>
        <UnitName Value="SplitButton"/>
      </Item>
      <Item>
        <Filename Value="linklabel.pas"/>
        <UnitName Value="LinkLabel"/>
      </Item>
      <Item>
        <Filename Value="segmentedcontrol.pas"/>
        <UnitName Value="SegmentedControl"/>
      </Item>
      <Item>
        <Filename Value="colorpicker.pas"/>
        <UnitName Value="ColorPicker"/>
      </Item>
      <Item>
        <Filename Value="busyindicator.pas"/>
        <UnitName Value="BusyIndicator"/>
      </Item>
      <Item>
        <Filename Value="progressring.pas"/>
        <UnitName Value="ProgressRing"/>
      </Item>
      <Item>
        <Filename Value="suggestedit.pas"/>
        <UnitName Value="SuggestEdit"/>
      </Item>
      <Item>
        <Filename Value="badge.pas"/>
        <UnitName Value="Badge"/>
      </Item>
      <Item>
        <Filename Value="rating.pas"/>
        <UnitName Value="Rating"/>
      </Item>
      <Item>
        <Filename Value="led.pas"/>
        <UnitName Value="Led"/>
      </Item>
      <Item>
        <Filename Value="sparkline.pas"/>
        <UnitName Value="Sparkline"/>
      </Item>
      <Item>
        <Filename Value="marquee.pas"/>
        <UnitName Value="Marquee"/>
      </Item>
      <Item>
        <Filename Value="knob.pas"/>
        <UnitName Value="Knob"/>
      </Item>
      <Item>
        <Filename Value="gauge.pas"/>
        <UnitName Value="Gauge"/>
      </Item>
      <Item>
        <Filename Value="clock.pas"/>
        <UnitName Value="Clock"/>
      </Item>
      <Item>
        <Filename Value="richlabel.pas"/>
        <UnitName Value="RichLabel"/>
      </Item>
      <Item>
        <Filename Value="passwordedit.pas"/>
        <UnitName Value="PasswordEdit"/>
      </Item>
      <Item>
        <Filename Value="hotkeyedit.pas"/>
        <UnitName Value="HotKeyEdit"/>
      </Item>
      <Item>
        <Filename Value="durationedit.pas"/>
        <UnitName Value="DurationEdit"/>
      </Item>
      <Item>
        <Filename Value="imageviewer.pas"/>
        <UnitName Value="ImageViewer"/>
      </Item>
      <Item>
        <Filename Value="qrcode.pas"/>
        <UnitName Value="QRCode"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="UnleashedThemeEngine"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
